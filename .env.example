# Frontend Supabase configuration (publishable key is safe for browser use with RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# Optional compatibility for legacy projects:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Function Secrets (server-side only; never add VITE_ prefix)
# AULAA_API_KEY=pgw_id_your_api_key_here
# AULAA_WEBHOOK_SECRET=your_aulaa_webhook_secret_here
# SUPABASE_SERVICE_ROLE_KEY is provisioned by Supabase in hosted Edge Functions.
# Do not copy the service-role key into frontend or Vercel environment variables.

# Optional Vercel compatibility relay only (if Aulaa still calls /api/aulaa-webhook).
# The canonical webhook processor is Supabase /functions/v1/aulaa-webhook.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
